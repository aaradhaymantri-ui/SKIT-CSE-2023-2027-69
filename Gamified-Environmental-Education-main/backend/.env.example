# ================================================================
# Flask Backend - Supabase & Environment Configuration Template
# ================================================================

# Supabase PostgreSQL Connection URI
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# Supabase Project API Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Flask Settings
FLASK_ENV=development
SECRET_KEY=your-flask-secret-key-change-in-production
PORT=5000
